# Hermes 3.0 — copy to .env for local runs. NEVER commit a real .env file.
# On Render, set these in the dashboard (Environment tab) instead.

# --- required ---------------------------------------------------------------
DISCORD_TOKEN=
# Your numeric Discord user ID (enable Developer Mode -> right-click yourself -> Copy User ID)
ALLOWED_USER_ID=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- provider selection -----------------------------------------------------
ACTIVE_PROVIDER=groq
# A stale ID is detected and replaced automatically (Groq retires models often).
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning models only (gpt-oss/qwen3): low | medium | high
GROQ_REASONING_EFFORT=low
# Leave empty to auto-discover a text model available to your Gemini key.
GEMINI_MODEL=
# Optional: custom Gemini-compatible endpoint
GEMINI_API_BASE=

# --- agent behaviour --------------------------------------------------------
MAX_AGENT_STEPS=8
AI_TIMEOUT=150
MAX_HISTORY_MESSAGES=10
TEMPERATURE=0.2
MAX_COMPLETION_TOKENS=1500
PROVIDER_COOLDOWN=60
# After a *daily* quota error, keep the provider out of rotation this long
QUOTA_COOLDOWN=3600
# If a provider says "retry in Ns" and N is <= this, wait instead of failing
RATE_LIMIT_WAIT_CAP=20
TASK_RATE_LIMIT=3

# --- workspace / commands ---------------------------------------------------
DATA_DIR=./data
WORKSPACE_DIR=./data/workspace
MAX_FILE_BYTES=200000
MAX_OUTPUT_CHARS=4000
COMMAND_TIMEOUT=45
APPROVAL_TTL=900
# Keep false unless you really want the agent able to run `git push`
ALLOW_GIT_PUSH=false

# --- service ----------------------------------------------------------------
PORT=10000
LOG_LEVEL=INFO

# --- web access ------------------------------------------------------------
WEB_ENABLED=true
WEB_TIMEOUT=20
WEB_MAX_BYTES=2000000
WEB_MAX_CHARS=7000
# Optional: restrict fetching to these domains (comma separated, empty = any public host)
WEB_ALLOWED_DOMAINS=

# Search: tavily | brave (needs SEARCH_API_KEY) or searxng (needs SEARXNG_URL)
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARXNG_URL=

# Real headless browser for JavaScript pages. Needs ~400-500 MB RAM:
#   pip install playwright && playwright install --with-deps chromium
BROWSER_ENABLED=false
BROWSER_TIMEOUT=30

# --- connectors (leave blank to disable that connector) ---------------------
# A connector is active when its variable is set and you have not !disconnect'ed it.
GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_BOT_TOKEN=
NETLIFY_TOKEN=
RENDER_API_KEY=
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
