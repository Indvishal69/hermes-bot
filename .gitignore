# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.txt

# Hermes runtime data (SQLite, backups, workspace, agent output)
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
backups/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (the agent may build Node projects inside data/workspace)
node_modules/
npm-debug.log*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
